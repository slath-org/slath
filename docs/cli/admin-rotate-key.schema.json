{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slath.org/schemas/cli/admin-rotate-key.schema.json",
  "title": "slath admin rotate-key --output json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "ok",
        "rotation"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": "boolean",
          "description": "False if some values couldn't be re-encrypted (see failed)."
        },
        "rotation": {
          "type": "object",
          "required": [
            "current_key",
            "reencrypted",
            "failed",
            "retired"
          ],
          "additionalProperties": false,
          "properties": {
            "current_key": {
              "type": "string"
            },
            "reencrypted": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "table",
                  "row",
                  "key_id",
                  "error"
                ],
                "additionalProperties": false,
                "properties": {
                  "table": {
                    "type": "string"
                  },
                  "row": {
                    "type": "string"
                  },
                  "key_id": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                }
              }
            },
            "retired": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "description": "What went wrong, for people."
        }
      }
    }
  }
}

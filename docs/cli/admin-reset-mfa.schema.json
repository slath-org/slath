{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slath.org/schemas/cli/admin-reset-mfa.schema.json",
  "title": "slath admin reset-mfa --output json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "ok",
        "username"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true
        },
        "username": {
          "type": "string"
        }
      }
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "error": {
      "type": "object",
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "string",
          "description": "What went wrong, for people."
        }
      }
    }
  }
}

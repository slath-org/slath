  "query": "SELECT a.issue_id, a.user_id, n.name::text AS \"name!\" FROM issue_assignees a\n           JOIN users u ON u.id = a.user_id JOIN namespaces n ON n.id = u.namespace_id\n           WHERE a.issue_id = ANY($1) ORDER BY lower(n.name::text)",

  "query": "SELECT il.issue_id, l.id, l.name::text AS \"name!\", l.color::text AS \"color!\", l.description\n           FROM issue_labels il JOIN labels l ON l.id = il.label_id\n           WHERE il.issue_id = ANY($1) ORDER BY lower(l.name::text)",

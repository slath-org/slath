{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE jobs SET\n            state = 'running',\n            attempts = attempts + 1,\n            locked_by = $2,\n            locked_until = now() + $3\n        WHERE id = (\n            SELECT id FROM jobs\n            WHERE queue = $1\n              AND attempts < max_attempts\n              AND ((state = 'ready' AND run_at <= now())\n                OR (state = 'running' AND locked_until < now()))\n            ORDER BY run_at, id\n            FOR UPDATE SKIP LOCKED\n            LIMIT 1\n        )\n        RETURNING id, queue, kind, payload, attempts, max_attempts\n        ",

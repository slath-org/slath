{
  "db_name": "PostgreSQL",
  "query": "SELECT a.id, a.fingerprint, a.rule, a.description, n.name::text AS \"created_by?\", a.reason, a.created_at, a.expires_at\n             FROM secret_allowances a\n             LEFT JOIN users u ON u.id = a.created_by\n             LEFT JOIN namespaces n ON n.id = u.namespace_id\n            WHERE a.repo_id = $1 AND a.expires_at > now()\n            ORDER BY a.created_at DESC\n            LIMIT 200",

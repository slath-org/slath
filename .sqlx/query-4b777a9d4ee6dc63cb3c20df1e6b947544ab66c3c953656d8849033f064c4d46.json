  "query": "SELECT id, user_id, name, token_prefix, scopes, repo_ids, expires_at, last_used_at, revoked_at, created_at\n         FROM access_tokens\n         WHERE token_hash = $1 AND revoked_at IS NULL AND (expires_at IS NULL OR expires_at > now())",

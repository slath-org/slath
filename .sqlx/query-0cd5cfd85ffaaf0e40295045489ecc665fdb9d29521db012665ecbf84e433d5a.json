  "query": "SELECT m.user_id, n.name::text AS \"name!\", u.display_name, m.role\n           FROM org_members m JOIN users u ON u.id = m.user_id JOIN namespaces n ON n.id = u.namespace_id\n           WHERE m.org_id = $1 ORDER BY m.role DESC, n.name LIMIT 1000",

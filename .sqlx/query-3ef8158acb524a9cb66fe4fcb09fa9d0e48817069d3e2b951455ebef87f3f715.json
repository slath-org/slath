  "query": "SELECT w.* FROM webhooks w\n          WHERE w.active AND (w.repo_id = $1 OR w.org_id = (\n                SELECT o.id FROM repositories r JOIN organizations o ON o.namespace_id = r.namespace_id\n                 WHERE r.id = $1))\n          ORDER BY w.created_at, w.id",

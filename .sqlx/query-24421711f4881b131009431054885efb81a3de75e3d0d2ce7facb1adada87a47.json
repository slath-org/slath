  "query": "SELECT v.mr_id, v.seq, v.merge_base_oid\n         FROM mr_revisions v JOIN merge_requests m ON m.id = v.mr_id\n         WHERE m.repo_id = $1 AND m.state = 'open' AND v.head_oid = $2\n         ORDER BY m.number, v.seq",

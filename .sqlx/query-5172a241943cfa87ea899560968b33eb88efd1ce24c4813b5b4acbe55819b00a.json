{
  "db_name": "PostgreSQL",
  "query": "SELECT l.id, l.name::text AS \"name!\", l.color::text AS \"color!\", l.description,\n                  (SELECT count(*) FROM issue_labels il JOIN issues i ON i.id = il.issue_id\n                   WHERE il.label_id = l.id AND i.state = 'open') AS \"open_issues!\"\n           FROM labels l WHERE l.repo_id = $1 ORDER BY lower(l.name::text)",

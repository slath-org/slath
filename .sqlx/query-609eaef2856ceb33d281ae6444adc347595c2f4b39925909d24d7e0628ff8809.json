{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.order_id, o.repo_id, o.bot_id, t.last_used_at\n           FROM task_tokens t JOIN work_orders o ON o.id = t.order_id\n          WHERE t.token_hash = $1 AND t.revoked_at IS NULL AND t.expires_at > now()\n            AND o.state = 'open' AND o.expires_at > now()",

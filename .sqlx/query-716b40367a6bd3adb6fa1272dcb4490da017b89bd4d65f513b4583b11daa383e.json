{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id_hash, s.user_id, n.name::text AS \"user_name!\", u.kind, u.state, u.is_admin,\n                  u.avatar_blob_sha256, (u.email IS NULL OR u.email_verified) AS \"email_confirmed!\", u.theme,\n                  u.density, u.code_font_size, u.editor_mode,\n                  s.created_at, s.last_seen_at, s.expires_at, s.auth_level, s.sudo_until,\n                  host(s.ip) AS ip, s.user_agent\n           FROM sessions s\n           JOIN users u ON u.id = s.user_id\n           JOIN namespaces n ON n.id = u.namespace_id\n           WHERE s.id_hash = $1 AND s.expires_at > now() AND s.last_seen_at > now() - $2::interval",

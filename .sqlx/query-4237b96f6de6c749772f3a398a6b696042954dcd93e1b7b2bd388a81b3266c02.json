  "query": "SELECT a.repo_id, n.name::text || '/' || r.name::text AS \"full!\", a.role FROM repo_team_access a\n           JOIN repositories r ON r.id = a.repo_id JOIN namespaces n ON n.id = r.namespace_id\n           WHERE a.team_id = $1 AND r.state <> 'deleting' ORDER BY 2",

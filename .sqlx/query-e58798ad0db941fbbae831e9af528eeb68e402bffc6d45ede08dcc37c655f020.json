{
  "db_name": "PostgreSQL",
  "query": "SELECT e.id, n.name::text AS actor, e.kind, e.data, e.created_at\n           FROM timeline_events e LEFT JOIN users u ON u.id = e.actor_id AND u.state <> 'deleted'\n           LEFT JOIN namespaces n ON n.id = u.namespace_id\n           WHERE e.subject_kind = $1 AND e.subject_id = $2 ORDER BY e.created_at, e.id",

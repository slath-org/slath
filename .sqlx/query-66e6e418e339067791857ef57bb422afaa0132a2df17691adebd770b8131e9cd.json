{
  "db_name": "PostgreSQL",
  "query": "SELECT k.id, k.repo_id AS \"repo_id!\", k.title, k.key_type, k.public_key, k.fingerprint_sha256,\n                  k.can_push, NULL::text AS added_by, k.last_used_at, k.created_at\n           FROM ssh_keys k\n           WHERE k.repo_id IS NOT NULL\n             AND (k.fingerprint_sha256 = $1 OR k.id = $2)",

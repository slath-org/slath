  "query": "SELECT n.name::text AS frozen_by, f.frozen_at\n           FROM bot_freezes f\n           LEFT JOIN users u ON u.id = f.frozen_by AND u.state <> 'deleted'\n           LEFT JOIN namespaces n ON n.id = u.namespace_id\n           WHERE f.org_id IS NOT DISTINCT FROM $1",

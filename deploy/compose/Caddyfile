# TLS in front of Slath (`docker compose --profile tls up -d`). Caddy serves
# the host in SLATH_PUBLIC_URL (https://git.example.org) and obtains its
# certificate. Slath trusts exactly this container's address as its proxy
# (SLATH_PROXY_IP in compose.yml).

{$SLATH_PUBLIC_URL} {
	encode zstd gzip
	reverse_proxy slath:3000
}

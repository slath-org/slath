#
# Copy to .env and adjust.

# Required: the PostgreSQL password (any long random string).
SLATH_DB_PASSWORD=

# The URL people use to reach Slath. With the tls profile: https://<SLATH_DOMAIN>
SLATH_PUBLIC_URL=http://localhost:3000

# Where the HTTP port is published. Keep it on 127.0.0.1 behind a proxy.
SLATH_HTTP_BIND=127.0.0.1:3000

# The SSH port: published address and the port shown in clone URLs.
SLATH_SSH_BIND=0.0.0.0:2222
SLATH_SSH_PORT=2222

# For `--profile tls` (Caddy obtains a certificate for this name).
SLATH_DOMAIN=git.example.org

# Image to run; `docker compose build` builds it from this checkout.
SLATH_IMAGE=slath:latest

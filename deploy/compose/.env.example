#
# Copy to .env. The first two values are all Slath needs.

# The PostgreSQL password (any long random string, e.g. `openssl rand -hex 24`).
SLATH_DB_PASSWORD=

# The URL people use to reach Slath. With `--profile tls`: https://<your host>
SLATH_PUBLIC_URL=http://localhost:3000

# Optional, with their defaults:
# SLATH_VERSION=0.3.0              # the release to run; change it to update
# SLATH_HTTP_BIND=127.0.0.1:3000   # where the HTTP port is published
# SLATH_SSH_BIND=0.0.0.0:2222      # where the SSH port is published ...
# SLATH_SSH_PORT=2222              # ... and the port shown in clone URLs
# SLATH_TLS=acme                   # --profile tls: acme | internal (private CA) | files (your cert)
# SLATH_CERTS_DIR=./certs          # with SLATH_TLS=files: cert.pem and key.pem
# SLATH_SUBNET=172.29.79.0/24      # change all three if this subnet is taken
# SLATH_DYNAMIC_RANGE=172.29.79.128/25
# SLATH_PROXY_IP=172.29.79.10
